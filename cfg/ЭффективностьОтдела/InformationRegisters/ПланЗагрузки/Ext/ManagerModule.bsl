&Сервер

// Плановые часы сотрудника за период: нужно для расчёта % загрузки в отчёте.
Функция ПланСотрудникаЗаПериод(Сотрудник, НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	СУММА(ПланЗагрузки.ПланЧасы) КАК ПланЧасы
		|ИЗ
		|	РегистрСведений.ПланЗагрузки КАК ПланЗагрузки
		|ГДЕ
		|	ПланЗагрузки.Сотрудник = &Сотрудник
		|	И ПланЗагрузки.Период МЕЖДУ &НачалоПериода И &КонецПериода";
	
	Запрос.УстановитьПараметр("Сотрудник", Сотрудник);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Выборка = Запрос.Выполнить().Выгрузить();
	// Тернарная запись в BSL — функция ?(условие, еслиИстина, еслиЛожь), а не инфиксный
	// оператор `условие ? значение : значение`: по 26038 каноническим модулям корпусов
	// инфиксной формы там нет, а функция ?(…) используется массово.
	Возврат ?(Выборка.Количество() > 0, Выборка[0].ПланЧасы, 0);
КонецФункции

// Итоги плана по сотрудникам за период (обычная группировка: виртуальные таблицы итогов
// будут проверены отдельно, их имена зависят от состава ресурсов и измерений).
Функция ПланПоСотрудникамЗаПериод(НачалоПериода, КонецПериода) Экспорт
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ПланЗагрузки.Сотрудник КАК Сотрудник,
		|	СУММА(ПланЗагрузки.ПланЧасы) КАК ПланЧасы
		|ИЗ
		|	РегистрСведений.ПланЗагрузки КАК ПланЗагрузки
		|ГДЕ
		|	ПланЗагрузки.Период МЕЖДУ &НачалоПериода И &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО ПланЗагрузки.Сотрудник
		|
		|УПОРЯДОЧИТЬ ПО Сотрудник";
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);
	
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
