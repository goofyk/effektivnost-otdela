// Расчёт показателей эффективности отдела.
// Utilization здесь — мера использования ёмкости, а не персональный KPI: число показывает,
// насколько плановая ёмкость сотрудника заполнена фактическими работами.

// Нормативная ёмкость месяца при ставке 1,0 (константа конфигурации).
Функция НормаЧасовЗаМесяц() Экспорт
	Возврат Константы.НормаЧасовВМесяц.Получить();
КонецФункции

// Ёмкость сотрудника за месяц: норма часов × ставка FTE.
Функция ЁмкостьСотрудникаЗаМесяц(Ставка) Экспорт
	Если Ставка <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(НормаЧасовЗаМесяц() * Ставка, 2);
КонецФункции

// Коэффициент загрузки: факт делить на план. Больше 1.10 — системная перегрузка.
Функция КоэффициентЗагрузки(ФактЧасы, ПланЧасы) Экспорт
	Если ПланЧасы <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр(ФактЧасы / ПланЧасы, 4);
КонецФункции

// Пояснение к коэффициенту словами: решение принимает руководитель, а не формула.
Функция ПояснениеЗагрузки(Коэффициент) Экспорт
	Если Коэффициент = 0 Тогда
		Возврат "План не задан";
	ИначеЕсли Коэффициент < 0.70 Тогда
		Возврат "Недозагрузка: ёмкость используется не полностью";
	ИначеЕсли Коэффициент <= 1.10 Тогда
		Возврат "Загрузка в норме";
	ИначеЕсли Коэффициент <= 1.30 Тогда
		Возврат "Перегрузка: посмотреть распределение работ";
	Иначе
		Возврат "Системная перегрузка: менять план или состав работ";
	КонецЕсли;
КонецФункции

// Оценка трудозатрат по трём точкам (PERT): ожидаемое = (O + 4*M + P) / 6.
// Используется обработкой распределения, чтобы план не был одной «точной» цифрой.
Функция ОценкаТриТочки(Оптимистично, Реалистично, Пессимистично) Экспорт
	Если Оптимистично < 0 Или Реалистично < 0 Или Пессимистично < 0 Тогда
		Возврат 0;
	КонецЕсли;
	Возврат Окр((Оптимистично + 4 * Реалистично + Пессимистично) / 6, 2);
КонецФункции

// Разброс оценки показывает, насколько план надёжен: (P - O) / 6 в часах.
Функция РазбросОценки(Оптимистично, Пессимистично) Экспорт
	Возврат Окр((Пессимистично - Оптимистично) / 6, 2);
КонецФункции
