// Модуль объекта документа «ФактРаботы».
// Движения пишутся только при проведении: факт — это накопленный ресурс по сотруднику.
// Дату нового документа платформа подставляет сама, поэтому здесь только обработка проведения.

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	Если Не ЗначениеЗаполнено(Сотрудник) Тогда
		Отказ = Истина;
		Сообщить("Факт работы: не указан сотрудник, документ не проведён.");
		Возврат;
	КонецЕсли;
	
	Если Часы <= 0 Тогда
		Отказ = Истина;
		Сообщить("Факт работы: должно быть затрачено больше нуля часов.");
		Возврат;
	КонецЕсли;
	
	Движения.ЗатратыВремени.Заполнять(Истина);
	Движения.ЗатратыВремени.Очистить();
	
	Строка = Движения.ЗатратыВремени.Добавить();
	Строка.Период = Дата;
	Строка.ВидДвижения = ВидДвиженияНакопления.Приход;
	Строка.Сотрудник = Сотрудник;
	Строка.Часы = Часы;
КонецПроцедуры

// Факт правит только сам сотрудник или руководитель группы — это делает роль «СотрудникОтдела»
// и проверка прав на форме, а не этот модуль.
