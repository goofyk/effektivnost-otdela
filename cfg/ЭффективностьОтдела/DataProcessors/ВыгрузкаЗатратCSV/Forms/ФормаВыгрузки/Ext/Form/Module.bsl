#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Период по умолчанию: с начала текущего месяца по сегодняшний день.
	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		НачалоПериода = НачалоМесяца(ТекущаяДата());
	КонецЕсли;
	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		КонецПериода = КонецДня(ТекущаяДата());
	КонецЕсли;
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура СформироватьВыгрузку(Команда)
	ДанныеВыгрузки = СформироватьВыгрузкуНаСервере(НачалоПериода, КонецПериода);
	ТекстВыгрузки = ДанныеВыгрузки.Текст;
	СтрокВыгружено = ДанныеВыгрузки.СтрокВыгружено;

	Если СтрокВыгружено = 0 Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "За выбранный период затрат времени нет. Проверьте границы периода и записи регистра ЗатратыВремени.";
		Сообщение.Поле = "ТекстВыгрузки";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьВCSV(Команда)
	// Для веб-клиента работа с файлами недоступна.
	#Если НЕ ВебКлиент Тогда

	Если ПустаяСтрока(ТекстВыгрузки) Тогда
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Текст выгрузки пуст. Сначала сформируйте выгрузку.";
		Сообщение.Поле = "ТекстВыгрузки";
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		Возврат;
	КонецЕсли;

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		Диалог.Заголовок = "Выберите файл, куда записать выгрузку затрат";
		Диалог.МножественныйВыбор = Ложь;
		Диалог.Расширение = "csv";
		Диалог.Фильтр = "Файл CSV (*.csv)|*.csv";

	ДополнительныеПараметры = Новый Структура;
	ОписаниеОповещенияПослеВыбора = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект, ДополнительныеПараметры);

	Диалог.Показать(ОписаниеОповещенияПослеВыбора);

	#КонецЕсли
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Функция СформироватьВыгрузкуНаСервере(НачалоПериода, КонецПериода)
	Возврат Объект.СформироватьТекстВыгрузки(НачалоПериода, КонецПериода);
КонецФункции

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ДополнительныеПараметры) Экспорт

	// Для веб-клиента работа с файлами недоступна.
	#Если НЕ ВебКлиент Тогда

	ТипМассив = Тип("Массив");

	Если (ТипЗнч(ВыбранныеФайлы) = ТипМассив)
			И (ВыбранныеФайлы.Количество() > 0) Тогда

		ИмяФайла = ВыбранныеФайлы[0];

		Если НЕ ПустаяСтрока(ИмяФайла) Тогда

			ЗаписьТекста = Новый ЗаписьТекста(ИмяФайла, "UTF-8", Символы.ПС, Ложь, Символы.ПС);
				ЗаписьТекста.Записать(ТекстВыгрузки);
			ЗаписьТекста.Закрыть();

			ПоказатьОповещениеПользователя("Выгрузка затрат записана в файл " + ИмяФайла);

		КонецЕсли;

	КонецЕсли;

	#КонецЕсли

КонецПроцедуры

#КонецОбласти
