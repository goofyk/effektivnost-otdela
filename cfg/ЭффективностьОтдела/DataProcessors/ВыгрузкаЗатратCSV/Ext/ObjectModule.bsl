// Модуль объекта обработки «ВыгрузкаЗатратCSV».
// Здесь считается только текст выгрузки: плановые и фактические часы за период
// и коэффициент загрузки по каждому сотруднику. Выбор файла и запись файла —
// дело формы, объект к файлам не обращается.
//
// Utilization (коэффициент загрузки) — мера заполненности плановой ёмкости,
// а не персональный KPI: итог и решение по человеку принимает руководитель.

#Область ПрограммныйИнтерфейс

// Текст CSV за период [НачалоПериода .. КонецПериода] включительно.
// Первая строка — заголовок колонок, дальше по строке на сотрудника.
// Возврат: Структура(Текст, СтрокВыгружено), где СтрокВыгружено — строк данных без заголовка.
Функция СформироватьТекстВыгрузки(НачалоПериода, КонецПериода) Экспорт
	Если НачалоПериода = Неопределено Или КонецПериода = Неопределено Тогда
		Возврат Новый Структура("Текст, СтрокВыгружено", "", 0);
	КонецЕсли;

	ТекстПериода = Формат(НачалоПериода, "ДФ=dd.MM.yyyy");
	ТекстПериодаПо = Формат(КонецПериода, "ДФ=dd.MM.yyyy");

	СтрокиВыгрузки = Новый Массив;
	СтрокиВыгрузки.Добавить(СтрокаCSV(ЗаголовкиКолонокВыгрузки()));

	Выборка = ДанныеВыгрузкиЗаПериод(НачалоПериода, КонецПериода).Выбрать();
	СтрокВыгружено = 0;
	Пока Выборка.Следующий() Цикл
		Коэффициент = РасчётПоказателей.КоэффициентЗагрузки(Выборка.ФактЧасы, Выборка.ПланЧасы);

		КолонкиСтроки = Новый Массив;
		КолонкиСтроки.Добавить(Выборка.Наименование);
		КолонкиСтроки.Добавить(Выборка.Грейд);
		КолонкиСтроки.Добавить(Выборка.Ставка);
		КолонкиСтроки.Добавить(ТекстПериода);
		КолонкиСтроки.Добавить(ТекстПериодаПо);
		КолонкиСтроки.Добавить(Выборка.ФактЧасы);
		КолонкиСтроки.Добавить(Выборка.ПланЧасы);
		КолонкиСтроки.Добавить(Коэффициент);
		КолонкиСтроки.Добавить(РасчётПоказателей.ПояснениеЗагрузки(Коэффициент));
		СтрокиВыгрузки.Добавить(СтрокаCSV(КолонкиСтроки));

		СтрокВыгружено = СтрокВыгружено + 1;
	КонецЦикла;

	ТекстВыгрузки = СтрСоединить(СтрокиВыгрузки, Символы.ПС);

	Возврат Новый Структура("Текст, СтрокВыгружено", ТекстВыгрузки, СтрокВыгружено);
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Колонки CSV: сотрудник, грейд, ставка, границы периода, факт, план, загрузка, пояснение.
Функция ЗаголовкиКолонокВыгрузки()
	Заголовки = Новый Массив;
	Заголовки.Добавить("Сотрудник");
	Заголовки.Добавить("Грейд");
	Заголовки.Добавить("Ставка");
	Заголовки.Добавить("Период с");
	Заголовки.Добавить("Период по");
	Заголовки.Добавить("Факт, ч");
	Заголовки.Добавить("План, ч");
	Заголовки.Добавить("Загрузка");
	Заголовки.Добавить("Пояснение");

	Возврат Заголовки;
КонецФункции

// Факт берётся оборотами регистра затрат, план — свёрткой записей плана по границам периода.
// Итоги по сотруднику считаются до соединения: иначе строки плана умножились бы на строки факта.
Функция ДанныеВыгрузкиЗаПериод(НачалоПериода, КонецПериода)
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	ЗатратыВремениОбороты.Сотрудник КАК Сотрудник,
		|	СУММА(ЗатратыВремениОбороты.Часы) КАК ФактЧасы
		|ПОМЕСТИТЬ втФактЗатраты
		|ИЗ
		|	РегистрНакопления.ЗатратыВремени.Обороты(&НачалоПериода, &КонецПериода, , ) КАК ЗатратыВремениОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	ЗатратыВремениОбороты.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПланЗагрузкиЗаписи.Сотрудник КАК Сотрудник,
		|	СУММА(ПланЗагрузкиЗаписи.ПланЧасы) КАК ПланЧасы
		|ПОМЕСТИТЬ втПланЗагрузки
		|ИЗ
		|	РегистрСведений.ПланЗагрузки КАК ПланЗагрузкиЗаписи
		|ГДЕ
		|	ПланЗагрузкиЗаписи.Период >= &НачалоПериода
		|	И ПланЗагрузкиЗаписи.Период <= &КонецПериода
		|
		|СГРУППИРОВАТЬ ПО
		|	ПланЗагрузкиЗаписи.Сотрудник
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Сотрудники.Ссылка КАК Сотрудник,
		|	Сотрудники.Наименование КАК Наименование,
		|	Сотрудники.Грейд КАК Грейд,
		|	Сотрудники.Ставка КАК Ставка,
		|	ЕСТЬNULL(втФактЗатраты.ФактЧасы, 0) КАК ФактЧасы,
		|	ЕСТЬNULL(втПланЗагрузки.ПланЧасы, 0) КАК ПланЧасы
		|ИЗ
		|	Справочник.Сотрудники КАК Сотрудники
		|		ЛЕВОЕ СОЕДИНЕНИЕ втФактЗатраты КАК втФактЗатраты
		|		ПО Сотрудники.Ссылка = втФактЗатраты.Сотрудник
		|		ЛЕВОЕ СОЕДИНЕНИЕ втПланЗагрузки КАК втПланЗагрузки
		|		ПО Сотрудники.Ссылка = втПланЗагрузки.Сотрудник
		|ГДЕ
		|	НЕ Сотрудники.ЭтоГруппа
		|	И НЕ Сотрудники.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|УНИЧТОЖИТЬ втФактЗатраты
		|;
		|
		|УНИЧТОЖИТЬ втПланЗагрузки
		|;";

	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", КонецПериода);

	Возврат Запрос.Выполнить();
КонецФункции

// Строка CSV из значений колонок.
Функция СтрокаCSV(ЗначенияКолонок)
	ТекстКолонок = Новый Массив;
	Для Каждого ЗначениеКолонки Из ЗначенияКолонок Цикл
		ТекстКолонок.Добавить(ЗначениеКолонкиCSV(ЗначениеКолонки));
	КонецЦикла;

	Возврат СтрСоединить(ТекстКолонок, ";");
КонецФункции

// Колонка CSV: число — с двумя знаками после разделителя, ссылка — представлением,
// разделитель и кавычки экранируются, чтобы название сотрудника не расслоило строку.
Функция ЗначениеКолонкиCSV(ЗначениеКолонки)
	Если ЗначениеКолонки = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Если ТипЗнч(ЗначениеКолонки) = Тип("Число") Тогда
		ТекстКолонки = Формат(ЗначениеКолонки, "ЧДЦ=2; ЧГ=0");
	Иначе
		ТекстКолонки = Строка(ЗначениеКолонки);
	КонецЕсли;

	Если Найти(ТекстКолонки, ";") > 0
		Или Найти(ТекстКолонки, """") > 0
		Или Найти(ТекстКолонки, Символы.ПС) > 0 Тогда
		ТекстКолонки = """" + СтрЗаменить(ТекстКолонки, """", """""") + """";
	КонецЕсли;

	Возврат ТекстКолонки;
КонецФункции

#КонецОбласти
