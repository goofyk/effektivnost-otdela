// Модуль объекта справочника «Сотрудники».
// Здесь только то, что обязано выполняться на сервере при записи самого справочника.

Процедура ПередЗаписью(Отказ)
	Если Не ЗначениеЗаполнено(Наименование) Тогда
		Отказ = Истина;
		Сообщить("У сотрудника должно быть наименование.");
		Возврат;
	КонецЕсли;
	
	Если Ставка <= 0 Тогда
		Отказ = Истина;
		Сообщить("Ставка сотрудника должна быть больше нуля.");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ДатаПриёма) Тогда
		ДатаПриёма = ТекущаяДата();
	КонецЕсли;
КонецПроцедуры

// Сортировка списка для отчётов: сначала руководители групп, затем по убыванию ставки.
Функция СравнитьСотрудников(Сотрудник1, Сотрудник2) Экспорт
	Если Сотрудник1.Грейд <> Сотрудник2.Грейд Тогда
		Возврат Сотрудник1.Грейд.Код - Сотрудник2.Грейд.Код;
	КонецЕсли;
	Возврат Сотрудник2.Ставка - Сотрудник1.Ставка;
КонецФункции
